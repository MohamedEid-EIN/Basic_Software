{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Project: Build all",
      "type": "shell",
      "command": "make",
      "args": [
        "-f",
        "01_Build_System/Makefile",
        "all"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "icon": {
        "id": "play",
        "color": "terminal.ansiGreen"
      }
    },
    {
      "label": "Project: clean",
      "type": "shell",
      "command": "make",
      "args": [
        "-f",
        "01_Build_System/Makefile",
        "clean"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "icon": {
        "id": "trash",
        "color": "terminal.ansiRed"
      }
    },
    {
      "label": "Project: rebuild",
      "dependsOn": [
        "Project: clean",
        "Project: Build all"
      ],
      "dependsOrder": "sequence",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "icon": {
        "id": "sync",
        "color": "terminal.ansiYellow"
      }
    },
		{
      "label": "Project: clear",
      "type": "shell",
      "command": "clear",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
